# Microverse Environment Configuration
# Copy this file to .env and update values as needed

# Server Configuration
PORT=5000
HOST=0.0.0.0
NODE_ENV=development

# CORS Configuration
CORS_ORIGIN=http://localhost:5173

# Database Configuration
# DB_PATH=./data/microverse.sqlite

# Application Deployment Configuration
APP_PORT_MIN=3000
APP_PORT_MAX=9000

# Apps storage directory (default: <projectRoot>/apps). Tests override this.
# APPS_DIR=

# File Upload Limits
MAX_FILE_SIZE=104857600  # 100MB in bytes
MAX_FILES=100

# Public URL template for deployed-app "open" links. {name} -> app name.
# Set when exposing apps via subdomains behind a reverse proxy, e.g.:
#   APP_PUBLIC_URL_TEMPLATE=https://{name}.yourdomain.com
# Unset -> links use http://localhost:<port> (local dev).
# APP_PUBLIC_URL_TEMPLATE=

# Platform-managed nginx reverse proxy (opt-in). When PROXY_ENABLED=true, the
# platform writes per-app server blocks to PROXY_CONF_FILE (subdomain -> app
# port) and reloads nginx. Requires system nginx installed and write access to
# PROXY_CONF_FILE (its dir must be included by your nginx.conf — Debian/Ubuntu
# include /etc/nginx/conf.d/*.conf by default).
# PROXY_ENABLED=false
# PROXY_CONF_FILE=/etc/nginx/conf.d/microverse_apps.conf
# PROXY_BASE_DOMAIN=              # empty -> derived from APP_PUBLIC_URL_TEMPLATE
# SSL is reserved (structure only; v1 does NOT issue certs):
# PROXY_SSL_ENABLED=false
# PROXY_SSL_CERT=/etc/letsencrypt/live/<domain>/fullchain.pem
# PROXY_SSL_CERT_KEY=/etc/letsencrypt/live/<domain>/privkey.pem
#
# Custom domain mappings (managed via the /routes page or the /api/proxy-routes
# API) are written into the SAME PROXY_CONF_FILE as the auto subdomain blocks.
# Point each custom domain's DNS at this host and make sure system nginx listens
# on port 80 and includes this conf file. Custom mappings are HTTP-only (v1) and
# do NOT require PROXY_BASE_DOMAIN.

# Force the session cookie Secure flag (default: follows PROXY_SSL_ENABLED in
# production). Set to false to log in over plain HTTP while testing.
# SESSION_COOKIE_SECURE=false

# npm install / build timeouts (ms, default 300000 = 5 min)
NPM_INSTALL_TIMEOUT_MS=300000
NPM_BUILD_TIMEOUT_MS=300000

# nginx binary path for the nginx deploy type (default 'nginx' = PATH)
# On Windows set the full path, e.g. NGINX_BIN=D:\nginx\nginx.exe
NGINX_BIN=nginx

# Metrics sampler (resource monitoring): poll interval (ms) + ring-buffer cap (samples)
METRICS_INTERVAL_MS=10000
METRICS_MAX_SAMPLES=180

# PM2 Configuration
PM2_INSTANCE_NAME=microverse-server

# Admin auth (single admin login). ADMIN_PASSWORD is used ONCE on first boot
# to seed a bcrypt-hashed row in the users table; after that it is ignored.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Session cookie secret. MUST be set for multi-worker (PM2 cluster) deployments:
# every worker derives the signing key from this; an unset value gives each worker
# a different random key, so they reject each other's cookies (intermittent
# logouts / 401 "Authentication required"). Also required for sessions to survive
# restarts.
SESSION_SECRET=

# Session store: a shared sqlite file so sessions are visible to every PM2
# cluster worker and persist across restarts (connect-sqlite3; sqlite3 driver).
# SESSION_DB_PATH=data/sessions.sqlite
